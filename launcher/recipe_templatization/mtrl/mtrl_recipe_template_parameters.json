{
    "_comment": [
        "MTRL (Multi-Turn Reinforcement Learning) Recipe Template Parameters Configuration",
        "",
        "This file defines template structure and parameters for MTRL agentic RFT recipes.",
        ""
    ],
    "templates": {
        "mtrl_nova_lite_lora": {
            "recipe_template": {
                "run": {
                    "name": "{{name}}"
                },
                "batch": {
                    "training_batch_size": "{{global_batch_size}}",
                    "group_size": "{{group_size}}"
                },
                "rl": {
                    "advantage_method": "{{advantage_method}}",
                    "loss_fn": "{{loss_fn}}",
                    "clip_low_threshold": "{{clip_low_threshold}}",
                    "clip_high_threshold": "{{clip_high_threshold}}"
                },
                "sampling_params": {
                    "temperature": "{{temperature}}",
                    "top_p": "{{sampling_top_p}}",
                    "max_tokens": "{{sampling_max_tokens}}"
                },
                "val_sampling_params": {
                    "max_tokens": "{{sampling_max_tokens}}"
                },
                "val_metrics_config": {
                    "pass_k_values": "{{pass_k_values}}",
                    "success_threshold": "{{success_threshold}}"
                },
                "schedule": {
                    "epochs": "{{max_epochs}}",
                    "max_steps": "{{max_steps}}",
                    "save_every": "{{save_every}}",
                    "val_every": "{{val_every}}"
                },
                "model": {
                    "model_name": "{{model_name_or_path}}",
                    "lora_rank": "{{lora_rank}}",
                    "lora_alpha": "{{lora_alpha}}",
                    "learning_rate": "{{learning_rate}}",
                    "adam_beta1": "{{adam_beta1}}",
                    "adam_beta2": "{{adam_beta2}}",
                    "adam_eps": "{{adam_eps}}",
                    "weight_decay": "{{adam_weight_decay}}",
                    "grad_clip_norm": "{{adam_grad_clip_norm}}",
                    "lora_plus_lr_ratio": "{{lora_plus_lr_ratio}}"
                },
                "rollout": {
                    "max_concurrency": "{{rollout_max_concurrency}}",
                    "timeout": "{{rollout_timeout}}",
                    "max_retries": "{{rollout_max_retries}}"
                },
                "async_config": {
                    "max_steps_off_policy": "{{max_steps_off_policy}}"
                }
            },
            "override_parameters": {
                "learning_rate": {
                    "max": 0.01
                },
                "lora_rank": {
                    "min": 16,
                    "max": 32,
                    "default": 32,
                    "enum": null
                },
                "lora_alpha": {
                    "min": 16,
                    "max": 128,
                    "default": 64,
                    "enum": null
                },
                "max_epochs": {
                    "max": 30,
                    "default": 1
                },
                "max_steps": {
                    "min": 1,
                    "max": 1000,
                    "default": 50
                },
                "global_batch_size": {
                    "enum": [
                        8,
                        16,
                        32,
                        64
                    ]
                },
                "temperature": {
                    "default": 0.7
                },
                "data_path": {},
                "output_path": {}
            },
            "recipe_metadata_helpers": {
                "peft_techniques": {
                    "lora": "LoRA"
                },
                "customization_techniques": {
                    "mtrl": "MTRL"
                }
            }
        },
