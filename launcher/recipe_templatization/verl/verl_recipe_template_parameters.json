{
    "_comment": [
        "VERL (Volcano Engine Reinforcement Learning for LLMs) Recipe Template Parameters Configuration",
        "",
        "This file defines template structure and parameters for VERL recipes using",
        "reinforcement learning algorithms like GRPO and PPO for fine-tuning.",
        "",
        "Key Features:",
        "1. TEMPLATE MATCHING: Supports verl_grpo and verl_ppo algorithm types",
        "2. RL-SPECIFIC PARAMETERS: Includes reward model, critic, and actor configurations"
    ],
    "templates": {
        "grpo_rlaif": {
            "display_name": "GRPO RLAIF (LoRA)",
            "recipe_template": {
                "run": {
                    "name": "{{name}}",
                    "results_dir": "{{results_directory}}"
                },
                "training_config": {
                    "trainer": {
                        "total_epochs": "{{max_epochs}}",
                        "default_local_dir": "{{output_path}}",
                        "resume_from_path": "{{resume_from_path}}"
                    },
                    "actor_rollout_ref": {
                        "actor": {
                            "optim": {
                                "lr": "{{learning_rate}}",
                                "lr_warmup_steps_ratio": "{{lr_warmup_steps_ratio}}",
                                "weight_decay": "{{weight_decay}}",
                                "lr_warmup_steps": "{{warmup_steps}}",
                                "min_lr_ratio": "{{min_lr}}",
                                "min_lr": "{{min_lr}}"
                            },
                            "clip_ratio": "{{clip_ratio}}",
                            "kl_loss_coef": "{{kl_loss_coef}}",
                            "clip_ratio_high": "{{clip_ratio_high}}",
                            "clip_ratio_low": "{{clip_ratio_low}}",
                            "use_kl_loss": "{{use_kl_loss}}"
                        },
                        "rollout": {
                            "prompt_length": "{{max_prompt_length}}",
                            "n": "{{rollout_n}}",
                            "temperature": "{{rollout_temperature}}",
                            "val_kwargs": {
                                "temperature": "{{temperature}}"
                            }
                        },
                        "model": {
                            "path": "{{model_name_or_path}}",
                            "lora_rank": "{{lora_rank}}",
                            "lora_alpha": "{{lora_alpha}}"
                        }
                    },
                    "data": {
                        "train_files": "{{data_path}}",
                        "val_files": "{{validation_data_path}}",
                        "train_val_split_ratio": "{{train_val_split_ratio}}",
                        "train_batch_size": "{{global_batch_size}}",
                        "max_prompt_length": "{{max_prompt_length}}",
                        "max_response_length": "{{max_response_length}}"
                    },
                    "reward_model": {
                        "reward_kwargs": {
                            "kwargs": {
                                "model_id": "{{judge_model_id}}",
                                "llmj_prompt_template_path": "{{judge_prompt_template}}"
                            }
                        }
                    },
                    "mlflow": {
                        "tracking_uri": "{{mlflow_tracking_uri}}",
                        "run_id": "{{mlflow_run_id}}"
                    }
                }
            },
            "override_parameters": {
                "learning_rate": {
                    "min": 1e-07
                },
                "global_batch_size": {
                    "default": 128,
                    "enum": [
                        128,
                        256,
                        512,
                        1024
                    ]
                },
                "namespace": {
                    "default": "default"
                },
                "weight_decay": {
                    "default": 0.01
                },
                "lora_alpha": {
                    "default": 64
                },
                "warmup_steps": {
                    "min": -1
                },
                "min_lr": {
                    "default": 0.0,
                    "min": 0.0
                },
                "temperature": {
                    "default": 0
                },
                "max_prompt_length": {
                    "visibility_tier": "advanced",
                    "description": "Maximum number of tokens reserved for the prompt/input portion of each sequence. Cannot exceed the recipe's baked-in maximum."
                },
                "max_response_length": {
                    "visibility_tier": "advanced",
                    "description": "Maximum number of tokens allowed for the generated response portion. Cannot exceed the recipe's baked-in maximum."
                }
            },
            "recipe_metadata_helpers": {
                "peft_techniques": {
                    "lora": "LoRA"
                },
                "rl_algorithms": {
                    "grpo": "GRPO"
                },
                "hardware_types": {
                    "gpu": [
                        "ml.p4de.24xlarge",
                        "ml.p5.48xlarge"
                    ]
                }
            }
        },
