        "dpo": {
            "display_name": "DPO (LoRA)",
            "recipe_template": {
                "run": {
                    "name": "{{name}}",
                    "results_dir": "{{results_directory}}"
                },
                "training_config": {
                    "trainer": {
                        "total_epochs": "{{max_epochs}}",
                        "default_local_dir": "{{output_path}}",
                        "resume_from_path": "{{resume_from_path}}",
                        "beta": "{{adam_beta}}"
                    },
                    "model": {
                        "path": "{{model_name_or_path}}",
                        "lora_rank": "{{lora_rank}}",
                        "lora_alpha": "{{lora_alpha}}"
                    },
                    "optim": {
                        "lr": "{{learning_rate}}",
                        "lr_warmup_steps_ratio": "{{lr_warmup_steps_ratio}}",
                        "weight_decay": "{{weight_decay}}",
                        "lr_warmup_steps": "{{warmup_steps}}",
                        "min_lr_ratio": "{{min_lr}}",
                        "min_lr": "{{min_lr}}",
                        "lr_scheduler_type": "{{lr_scheduler}}",
                        "lr_decay_style": "{{lr_scheduler}}"
                    },
                    "data": {
                        "train_files": "{{data_path}}",
                        "val_files": "{{validation_data_path}}",
                        "train_batch_size": "{{global_batch_size}}",
                        "train_val_split_ratio": "{{train_val_split_ratio}}",
                        "max_length": "{{dataset_max_len}}"
                    },
                    "mlflow": {
                        "tracking_uri": "{{mlflow_tracking_uri}}",
                        "run_id": "{{mlflow_run_id}}"
                    }
                }
            },
            "override_parameters": {
                "learning_rate": {
                    "min": 1e-07,
                    "default": 0.0001,
                    "description": "Step size for weight updates during optimization. Controls how much model weights change per gradient step."
                },
                "global_batch_size": {
                    "enum": [
                        32,
                        64,
                        128,
                        256,
                        512,
                        1024
                    ],
                    "description": "Total number of samples processed per optimizer step across all GPUs and accumulation steps. Larger batch sizes provide more stable gradients but require more memory."
                },
                "namespace": {
                    "default": "default"
                },
                "adam_beta": {
                    "max": 1.0,
                    "default": 0.01,
                    "description": "KL divergence penalty coefficient for DPO. Controls how much the policy is penalized for deviating from the reference model. Lower values allow more deviation."
                },
                "lr_warmup_steps_ratio": {
                    "description": "Fraction of total training steps spent linearly ramping the learning rate from 0 up to the target value. Stabilizes early training by avoiding large initial updates."
                },
                "lora_rank": {
                    "description": "Rank of the low-rank decomposition in LoRA adapters. Higher rank increases expressiveness but uses more memory and compute."
                },
                "lora_alpha": {
                    "default": 64
                },
                "warmup_steps": {
                    "min": -1
                },
                "min_lr": {
                    "min": 0.0,
                    "default": 0.1,
                    "description": "Minimum learning rate floor at the end of the LR schedule. Prevents the learning rate from decaying below this value."
                },
                "lr_scheduler": {
                    "description": "Learning rate decay schedule over training. 'cosine' anneals the LR smoothly from peak to near-zero following a cosine curve."
                },
                "dataset_max_len": {
                    "visibility_tier": "advanced",
                    "description": "Maximum number of tokens in a single training example (prompt + completion). Longer sequences capture more context but use more memory."
                }
            },
            "recipe_metadata_helpers": {
