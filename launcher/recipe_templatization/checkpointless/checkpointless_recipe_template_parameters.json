{
    "_comment": [
        "Checkpointless Recipe Template Parameters Configuration",
        "Templates for checkpointless training recipes using NeMo framework"
    ],
    "templates": {
        "checkpointless_fine_tuning": {
            "display_name": "Fine-Tuning",
            "recipe_template": {
                "instance_types": "{{instance_types}}",
                "run": {
                    "name": "{{model_name}}",
                    "results_dir": "{{results_directory}}",
                    "time_limit": "{{time_limit}}"
                },
                "trainer": {
                    "num_nodes": "{{num_nodes}}",
                    "max_steps": "{{max_steps}}",
                    "val_check_interval": "{{val_check_interval}}",
                    "log_every_n_steps": "{{log_every_n_steps}}"
                },
                "data": {
                    "seq_length": "{{sequence_length}}",
                    "global_batch_size": "{{global_batch_size}}"
                },
                "dataset": {
                    "dataset_path": "{{dataset_path}}"
                },
                "log_dir": "{{log_directory}}",
                "optim": {
                    "config": {
                        "lr": "{{learning_rate}}"
                    }
                },
                "cluster": {
                    "instance_count": "{{instance_count}}",
                    "namespace": "{{namespace}}"
                }
            },
            "override_parameters": {
                "max_steps": {
                    "default": 1168251,
                    "min": 1000,
                    "max": 10000000
                },
                "global_batch_size": {
                    "default": 2,
                    "enum": [
                        2,
                        4,
                        8,
                        16,
                        32,
                        64
                    ]
                },
                "learning_rate": {
                    "default": 0.0001,
                    "min": 1e-06
                },
                "namespace": {
                    "required": false,
                    "default": ""
                }
            },
            "recipe_metadata_helpers": {
                "fine_tuning_techniques": {
                    "fine_tuning": "FineTuning"
                }
            }
        },
        "checkpointless_pretrain": {
            "display_name": "Pretraining",
            "recipe_template": {
                "instance_types": "{{instance_types}}",
                "run": {
                    "name": "{{model_name}}",
                    "results_dir": "{{results_directory}}",
                    "time_limit": "{{time_limit}}"
                },
                "trainer": {
                    "num_nodes": "{{num_nodes}}",
                    "max_steps": "{{max_steps}}",
                    "val_check_interval": "{{val_check_interval}}",
                    "log_every_n_steps": "{{log_every_n_steps}}"
                },
                "data": {
                    "seq_length": "{{sequence_length}}",
                    "global_batch_size": "{{global_batch_size}}"
                },
                "dataset": {
                    "dataset_path": "{{dataset_path}}"
                },
                "log_dir": "{{log_directory}}",
                "optim": {
                    "config": {
                        "lr": "{{learning_rate}}"
                    }
                },
                "cluster": {
                    "instance_type": "{{instance_type}}",
                    "instance_count": "{{instance_count}}",
                    "namespace": "{{namespace}}"
                }
            },
            "override_parameters": {
                "model_name": {
                    "default": "llama-70b"
                },
                "max_steps": {
                    "default": 1000000,
                    "min": 1000,
                    "max": 10000000
                },
                "global_batch_size": {
                    "default": 2,
                    "enum": [
                        2,
                        4,
                        8,
                        16,
                        32,
                        64
                    ]
                },
                "learning_rate": {
                    "default": 0.0001,
                    "min": 1e-06
                },
                "namespace": {
                    "required": false,
                    "default": ""
                }
            },
            "recipe_metadata_helpers": {
                "training_types": {
                    "pretrain": "PreTraining"
                }
            }
        }
    }
}
