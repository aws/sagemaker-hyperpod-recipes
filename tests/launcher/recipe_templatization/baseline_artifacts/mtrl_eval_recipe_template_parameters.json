{
    "_comment": [
        "MTRL Eval Recipe Template Parameters Configuration",
        "",
        "This file defines template structure and parameters for MTRL agentic eval recipes.",
        "Only deterministic evaluation is supported (no LLMAJ, no benchmark).",
        "",
        "`name`, `sampling_temperature`, `top_p`, `max_tokens`, `eval_group_size`,",
        "`pass_k_values`, and `success_threshold` are customer-overridable."
    ],
    "templates": {
        "mtrl_eval": {
            "recipe_template": {
                "run": {
                    "base_model_name": "{{base_model_name}}",
                    "name": "{{name}}"
                },
                "batch": {
                    "eval_group_size": "{{eval_group_size}}"
                },
                "eval_metrics_config": {
                    "pass_k_values": "{{pass_k_values}}",
                    "success_threshold": "{{success_threshold}}"
                },
                "eval_sampling_params": {
                    "temperature": "{{temperature}}",
                    "top_p": "{{sampling_top_p}}",
                    "max_tokens": "{{sampling_max_tokens}}"
                },
                "model": {
                    "model_name": "{{model_name}}"
                },
                "rollout": {
                    "max_concurrency": "{{rollout_max_concurrency}}",
                    "timeout": "{{rollout_timeout}}",
                    "max_retries": "{{rollout_max_retries}}"
                }
            },
            "recipe_override_parameters": {
                "base_model_name": {
                    "type": "string",
                    "default": "",
                    "required": true,
                    "category": "system",
                    "visibility_tier": "tertiary"
                },
                "model_name": {
                    "type": "string",
                    "default": "",
                    "required": true,
                    "description": "Model identifier",
                    "category": "system",
                    "visibility_tier": "advanced",
                    "display_name": "Model Name"
                },
                "name": {
                    "type": "string",
                    "required": true,
                    "default": "",
                    "description": "Custom model name",
                    "category": "system",
                    "visibility_tier": "tertiary",
                    "display_name": "Evaluation name"
                },
                "eval_group_size": {
                    "type": "integer",
                    "required": true,
                    "min": 1,
                    "max": 128,
                    "default": 1,
                    "description": "Rollouts per prompt. Note: To compute pass@k, set eval_group_size >= k.",
                    "category": "hyperparameter",
                    "visibility_tier": "primary",
                    "display_name": "Samples per prompt (K)"
                },
                "pass_k_values": {
                    "type": "array",
                    "required": true,
                    "default": [
                        1,
                        2,
                        4,
                        8,
                        16,
                        32
                    ],
                    "description": "List of k values for computing pass@k and pass^k metrics. pass@k = probability that at least 1 of k sampled rollouts succeeds. pass^k = probability that all k rollouts succeed.",
                    "category": "hyperparameter",
                    "visibility_tier": "primary",
                    "display_name": "Pass@K values"
                },
                "success_threshold": {
                    "type": "float",
                    "required": true,
                    "default": 1.0,
                    "description": "A rollout is 'successful' when reward >= success_threshold. Note this applies for pass@k, pass^k, succeeded/failed count metrics.",
                    "category": "hyperparameter",
                    "visibility_tier": "primary",
                    "display_name": "Success threshold"
                },
                "temperature": {
                    "type": "float",
                    "required": true,
                    "min": 0.0,
                    "max": 2.0,
                    "default": 0,
                    "description": "Sampling temperature for evaluation and generation. Higher values increase output randomness/diversity; lower values make outputs more deterministic.",
                    "category": "hyperparameter",
                    "visibility_tier": "advanced",
                    "display_name": "Temperature",
                    "hint": "Must be a value between {min} and {max}"
                },
                "sampling_top_p": {
                    "type": "float",
                    "required": true,
                    "min": 0,
                    "max": 1,
                    "default": 1,
                    "description": "Nucleus sampling cutoff for evaluation rollouts.",
                    "category": "hyperparameter",
                    "visibility_tier": "advanced",
                    "display_name": "Sampling Top P"
                },
                "sampling_max_tokens": {
                    "type": "integer",
                    "required": true,
                    "min": 512,
                    "max": 8192,
                    "default": 4096,
                    "description": "Maximum tokens the model can generate per turn during evaluation rollouts.",
                    "category": "hyperparameter",
                    "visibility_tier": "advanced",
                    "display_name": "Sampling Max Tokens"
                },
                "rollout_max_concurrency": {
                    "type": "integer",
                    "required": true,
                    "min": 32,
                    "max": 96,
                    "default": 96,
                    "description": "Maximum number of evaluation rollouts that can execute in parallel.",
                    "category": "hyperparameter",
                    "visibility_tier": "advanced",
                    "display_name": "Rollout Max Concurrency"
                },
                "rollout_timeout": {
                    "type": "float",
                    "required": true,
                    "min": 300,
                    "max": 86400,
                    "default": 600,
                    "description": "Time (seconds) after which an evaluation rollout is treated as failed and may be retried.",
                    "category": "hyperparameter",
                    "visibility_tier": "advanced",
                    "display_name": "Rollout Timeout"
                },
                "rollout_max_retries": {
                    "type": "integer",
                    "required": true,
                    "min": 0,
                    "max": 10,
                    "default": 3,
                    "description": "Number of retry attempts for failed evaluation rollouts before marking them as permanently failed.",
                    "category": "hyperparameter",
                    "visibility_tier": "advanced",
                    "display_name": "Rollout Max Retries"
                }
            },
            "recipe_metadata_helpers": {
                "evaluation_types": {
                    "MTRLEvaluation": "MTRL Evaluation"
                }
            }
        }
    }
}
